# ─────────────────────────────────────────────────────────────
# FRONTEND (browser) — these are bundled into the JS output.
# Vite inlines every VITE_* var at build time, so anything here
# is PUBLIC. Never put a gateway secret or the service role key
# in this file.
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_SITE_URL=http://localhost:5173


# ─────────────────────────────────────────────────────────────
# EDGE FUNCTION SECRETS — set with:
#   supabase secrets set --project-ref <ref> KEY=value
# or in the Supabase dashboard (Edge Functions → Secrets).
# These are listed here for documentation only; they must NEVER
# appear in a VITE_* var or in committed code.
# ─────────────────────────────────────────────────────────────
# GATEWAY_PROVIDER=mock          # mock | manual | custom
# CUSTOM_GATEWAY_BASE_URL=
# CUSTOM_GATEWAY_API_KEY=
# CUSTOM_GATEWAY_SECRET=         # used for webhook HMAC verification
# SITE_URL=http://localhost:5173
